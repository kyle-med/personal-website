---
import Layout from '../../components/Layout.astro';
import { scales } from '../../data/scales';
import GcsComaScale from '../../components/scales/GcsComaScale.astro';
import RifleAkiScale from '../../components/scales/RifleAkiScale.astro';

export function getStaticPaths() {
  return scales.map((scale) => ({ params: { slug: scale.slug }, props: { scale } }));
}

const { scale } = Astro.props;

const componentMap: Record<string, typeof GcsComaScale> = {
  'gcs-coma-scale': GcsComaScale,
  'rifle-aki': RifleAkiScale,
};
const ScaleComponent = componentMap[scale.slug] || null;
---

<Layout title={`${scale.title} — Bedside Reference`} description={scale.description}>
  <article class="max-w-3xl mx-auto px-6 py-16">
    <a href="/reference" class="text-sm text-[var(--color-text-secondary)] hover:text-[var(--color-accent)] transition-colors mb-6 inline-block">&larr; Back to Reference</a>

    <header class="mb-8">
      <h1 class="font-serif text-3xl md:text-4xl font-extrabold text-[var(--color-text)] mb-3">{scale.title}</h1>
      <div class="flex flex-wrap items-center gap-3 text-sm text-[var(--color-text-secondary)]">
        <span class="text-xs px-2 py-0.5 rounded-full bg-[var(--color-bg)] border border-[var(--color-border)]">
          {scale.specialty}
        </span>
      </div>
    </header>

    <div class="mb-10">
      {ScaleComponent && <ScaleComponent />}
    </div>
  </article>
</Layout>

<script src="https://unpkg.com/vue@3/dist/vue.global.js" is:inline></script>

<script>
  import { createApp, reactive, computed } from 'https://unpkg.com/vue@3/dist/vue.esm-browser.js';

  const rifleEl = document.getElementById('rifle-app');
  if (rifleEl) {
    const stageOrder = { none: 0, R: 1, I: 2, F: 3, L: 4, E: 5 };

    createApp({
      setup() {
        const criteria = reactive({ scr: 'none', uo: 'none' });

        const options = {
          scr: [
            { stage: 'none', text: '无明显变化', label: '' },
            { stage: 'R', text: 'SCr ×1.5 或 GFR ↓ >25%', label: 'Risk' },
            { stage: 'I', text: 'SCr ×2 或 GFR ↓ >50%', label: 'Injury' },
            { stage: 'F', text: 'SCr ×3 或 GFR ↓ >75%，或 SCr ≥4 mg/dL 急性升高 ≥0.5', label: 'Failure' },
            { stage: 'L', text: '持续肾功能完全丧失 >4 周', label: 'Loss' },
            { stage: 'E', text: '终末期肾病 >3 个月', label: 'ESRD' },
          ],
          uo: [
            { stage: 'none', text: '无明显变化', label: '' },
            { stage: 'R', text: '<0.5 mL/kg/h ×6h', label: 'Risk' },
            { stage: 'I', text: '<0.5 mL/kg/h ×12h', label: 'Injury' },
            { stage: 'F', text: '<0.3 mL/kg/h ×24h 或无尿 ×12h', label: 'Failure' },
          ],
        };

        const resultStage = computed(() => {
          const s = stageOrder[criteria.scr];
          const u = stageOrder[criteria.uo];
          const worst = Math.max(s, u);
          if (worst === 0) return '—';
          const stages = ['none', 'R', 'I', 'F', 'L', 'E'];
          return stages[worst];
        });

        const resultDetail = computed(() => {
          const map = {
            none: '请选择上方标准',
            R: 'Risk — 危险期',
            I: 'Injury — 损伤期',
            F: 'Failure — 衰竭期',
            L: 'Loss — 功能丧失期',
            E: 'ESRD — 终末期肾病',
          };
          return map[resultStage.value] || '';
        });

        const resultColor = computed(() => {
          const colors = {
            '—': 'mt-10 p-8 rounded-3xl text-center shadow-lg transition-all duration-500 bg-gray-400 text-white shadow-gray-200',
            R: 'mt-10 p-8 rounded-3xl text-center shadow-lg transition-all duration-500 bg-yellow-500 text-white shadow-yellow-200',
            I: 'mt-10 p-8 rounded-3xl text-center shadow-lg transition-all duration-500 bg-orange-500 text-white shadow-orange-200',
            F: 'mt-10 p-8 rounded-3xl text-center shadow-lg transition-all duration-500 bg-red-500 text-white shadow-red-200',
            L: 'mt-10 p-8 rounded-3xl text-center shadow-lg transition-all duration-500 bg-red-700 text-white shadow-red-300',
            E: 'mt-10 p-8 rounded-3xl text-center shadow-lg transition-all duration-500 bg-red-900 text-white shadow-red-400',
          };
          return colors[resultStage.value] || colors['—'];
        });

        function selectedClass(current, val) {
          const base = 'px-5 py-4 flex justify-between items-center ios-btn border-b border-gray-50 last:border-0';
          return current === val ? base + ' bg-blue-50' : base;
        }

        function scoreClass(current, val) {
          return current === val ? 'text-sm text-blue-600 font-bold' : 'text-sm text-gray-400';
        }

        return { criteria, options, resultStage, resultDetail, resultColor, selectedClass, scoreClass };
      },
    }).mount('#rifle-app');
  }

  const mountEl = document.getElementById('gcs-app');
  if (mountEl) {
    createApp({
      setup() {
        const scores = reactive({
          e: 4,
          v: 5,
          m: 6,
        });

        const options = {
          eye: [
            { text: '自动睁眼', val: 4 },
            { text: '呼唤睁眼', val: 3 },
            { text: '刺痛睁眼', val: 2 },
            { text: '无反应', val: 1 },
          ],
          verbal: [
            { text: '回答准确', val: 5 },
            { text: '回答错误', val: 4 },
            { text: '胡言乱语', val: 3 },
            { text: '仅能发音', val: 2 },
            { text: '无反应', val: 1 },
          ],
          motor: [
            { text: '按指令动作', val: 6 },
            { text: '对刺痛能定位', val: 5 },
            { text: '刺痛时肢体回避', val: 4 },
            { text: '刺痛时肢体屈曲', val: 3 },
            { text: '刺痛时肢体伸直', val: 2 },
            { text: '无反应', val: 1 },
          ],
        };

        const totalScore = computed(() => scores.e + scores.v + scores.m);

        const scoreColor = computed(() =>
          totalScore.value <= 8
            ? 'mt-10 p-8 rounded-3xl text-center shadow-lg transition-all duration-500 bg-red-500 text-white shadow-red-200'
            : 'mt-10 p-8 rounded-3xl text-center shadow-lg transition-all duration-500 bg-blue-600 text-white shadow-blue-200'
        );

        function selectedClass(score, val) {
          const base = 'px-5 py-4 flex justify-between items-center ios-btn border-b border-gray-50 last:border-0';
          return score === val ? base + ' bg-blue-50' : base;
        }

        function scoreClass(score, val) {
          return score === val ? 'text-sm text-blue-600 font-bold' : 'text-sm text-gray-400';
        }

        return { scores, options, totalScore, scoreColor, selectedClass, scoreClass };
      },
    }).mount('#gcs-app');
  }
</script>

<style>
  .ios-btn {
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .ios-btn:active {
    transform: scale(0.96);
    opacity: 0.7;
  }
  input[type="radio"] {
    display: none;
  }
</style>
